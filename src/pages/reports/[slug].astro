---
// [slug].astro — dynamic route for MD content collection reports
import ReportLayout from '../../layouts/ReportLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map(report => {
    const slug = report.id.replace(/\.md$/, '');
    return {
      params: { slug },
      props: { report },
    };
  });
}

const { report } = Astro.props;
const { Content, headings } = await render(report);

const slug = report.id.replace(/\.md$/, '');

const formattedDate = report.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

<ReportLayout
  title={report.data.title}
  version={report.data.version}
  date={report.data.date.toISOString()}
  summary={report.data.summary}
  tags={report.data.tags}
  slug={slug}
  headings={headings}
>
  <!-- 1. Title -->
  <h1>{report.data.title}</h1>

  <!-- 2. Version & Summary metadata block -->
  <div class="report-meta">
    <div class="report-meta-item">
      <span class="report-meta-label">Version</span>
      <span class="report-meta-value">{report.data.version}</span>
    </div>
    <div class="report-meta-item">
      <span class="report-meta-label">Date</span>
      <span class="report-meta-value">{formattedDate}</span>
    </div>
    <div class="report-meta-item">
      <span class="report-meta-label">Tags</span>
      <div class="flex flex-wrap gap-1.5 mt-1">
        {report.data.tags.map(tag => <span class="report-tag">{tag}</span>)}
      </div>
    </div>
  </div>

  <div class="report-summary">
    <strong>Summary:</strong> {report.data.summary}
  </div>

  <!-- 3. Mobile TOC (inline, below summary — hidden on desktop where margin TOC shows) -->
  {tocHeadings.length > 0 && (
    <nav class="report-toc mobile-toc" id="report-toc-mobile">
      <div class="report-toc-title">📋 Contents</div>
      <ul>
        {tocHeadings.map(h => (
          <li>
            <a href={`#${h.slug}`} class={h.depth === 3 ? 'toc-level-2' : ''}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <!-- 4. Report content -->
  <Content />
</ReportLayout>

<style>
  /* Mobile TOC: visible only on small screens */
  .mobile-toc {
    display: block;
  }
  @media (min-width: 1101px) {
    .mobile-toc {
      display: none;
    }
  }
</style>