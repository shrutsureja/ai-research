---
// index.astro — dashboard: list all reports with search + tags (Dante theme)
import DashboardLayout from '../layouts/DashboardLayout.astro';
import ReportCard from '../components/ReportCard.astro';
import SearchBar from '../components/SearchBar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getCollection } from 'astro:content';

// Fetch all reports from content collection
const reports = await getCollection('reports');

// Sort by date descending
reports.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Gather all unique tags
const allTags = [...new Set(reports.flatMap(r => r.data.tags))].sort();
---

<DashboardLayout title="AI Research — Deep Dive Reports">
  <div class="flex flex-col min-h-screen px-4 md:px-8">
    <!-- Nav -->
    <nav class="pt-4 pb-8 relative">
      <div class="w-full max-w-3xl mx-auto relative flex items-center justify-between">
        <span class="font-serif text-base" style="color: rgb(var(--color-text-main));">
          AI Research
        </span>
        <ThemeToggle />
      </div>
    </nav>

    <main class="grow w-full max-w-3xl mx-auto">
      <!-- Header -->
      <header class="mb-12">
        <h1 class="text-3xl leading-tight font-serif font-medium sm:text-5xl sm:leading-tight" style="color: rgb(var(--color-text-main));">
          Deep Dive Reports
        </h1>
        <p class="mt-2 text-sm" style="color: rgb(var(--color-text-main) / 0.6);">
          Technical analyses, code reviews, and research notes.
        </p>
      </header>

      <!-- Search -->
      <SearchBar />

      <!-- Tag Filters -->
      <div class="flex flex-wrap gap-2 mb-6" id="tag-filters">
        <button
          class="tag-chip active px-3 py-1 rounded-full text-sm font-medium transition-all"
          data-tag=""
          style="border: 1px solid rgb(var(--color-border-main)); color: rgb(var(--color-text-main));"
        >
          All
        </button>
        {allTags.map(tag => (
          <button
            class="tag-chip px-3 py-1 rounded-full text-sm font-medium transition-all"
            data-tag={tag}
            style="border: 1px solid rgb(var(--color-border-main)); color: rgb(var(--color-text-main) / 0.6);"
          >
            {tag}
          </button>
        ))}
      </div>

      <!-- Report List -->
      <div class="grid grid-cols-1 gap-4 mb-8" id="report-grid">
        {reports.map(report => (
          <ReportCard
            title={report.data.title}
            summary={report.data.summary}
            date={report.data.date.toISOString()}
            tags={report.data.tags}
            slug={report.id.replace(/\.md$/, '')}
          />
        ))}
      </div>

      <!-- No Results -->
      <div id="no-results" class="hidden text-center py-16" style="color: rgb(var(--color-text-main) / 0.4);">
        <p class="text-lg font-medium">No reports found</p>
        <p class="text-sm mt-1">Try a different search or tag</p>
      </div>
    </main>

    <!-- Footer -->
    <footer class="w-full max-w-3xl mx-auto pt-8 pb-10">
      <div class="pt-6 flex flex-col gap-4 sm:flex-row sm:justify-between sm:items-center" style="border-top: 1px solid rgb(var(--color-border-main));">
        <p class="text-sm" style="color: rgb(var(--color-text-main) / 0.6);">
          {reports.length} report{reports.length !== 1 ? 's' : ''}
        </p>
        <p class="text-sm" style="color: rgb(var(--color-text-main) / 0.6);">
          Powered by Astro + Cloudflare Pages
        </p>
      </div>
    </footer>
  </div>

  <script is:inline>
    (function() {
      const chips = document.querySelectorAll('.tag-chip');

      function setActiveChip(activeChip) {
        chips.forEach(c => {
          c.classList.remove('active');
          c.style.background = '';
          c.style.color = 'rgb(var(--color-text-main) / 0.6)';
        });
        activeChip.classList.add('active');
        activeChip.style.background = 'rgb(var(--color-text-main))';
        activeChip.style.color = 'rgb(var(--color-bg-main))';
      }

      chips.forEach(chip => {
        chip.addEventListener('click', () => {
          setActiveChip(chip);
          document.dispatchEvent(new CustomEvent('tag-filter-changed'));
        });
      });

      // Initialize active chip
      const activeChip = document.querySelector('.tag-chip.active');
      if (activeChip) setActiveChip(activeChip);
    })();
  </script>
</DashboardLayout>