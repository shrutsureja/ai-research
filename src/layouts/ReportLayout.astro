---
// ReportLayout.astro — shared report theme for HTML and MD reports
import '../styles/report-theme.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  version?: string;
  date?: string;
  summary?: string;
  tags?: string[];
  slug?: string;
}

const { title, version, date, summary, tags = [], slug } = Astro.props;

// Format date nicely
const formattedDate = date
  ? new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={summary || title} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — AI Research</title>
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 dark:bg-[#0d1117] dark:text-slate-200 transition-colors">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
      <!-- Top Bar -->
      <div class="flex items-center justify-between mb-6">
        <a href="/" class="report-back">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          <span>Dashboard</span>
        </a>
        <ThemeToggle />
      </div>

      <!-- Report Content -->
      <article class="report-body">
        <slot />
      </article>

      <!-- Footer -->
      <footer class="mt-12 pt-6 border-t border-slate-200 dark:border-slate-700">
        <div class="flex items-center justify-between text-sm text-slate-500 dark:text-slate-400">
          <a href="/" class="hover:text-accent dark:hover:text-accent-light transition-colors">← Back to all reports</a>
          <span>AI Research</span>
        </div>
      </footer>
    </div>

    <script>
      // Smooth scroll for TOC links
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });
    </script>
  </body>
</html>