---
// ReportLayout.astro — centered report with left-margin TOC on desktop, inline on mobile
import '../styles/report-theme.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  version?: string;
  date?: string;
  summary?: string;
  tags?: string[];
  slug?: string;
  headings?: any[];
}

const { title, version, date, summary, tags = [], slug, headings = [] } = Astro.props;

const formattedDate = date
  ? new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;

const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

<!doctype html>
<html lang="en" class="antialiased break-words scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={summary || title} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — AI Research</title>
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen" style="background-color: rgb(var(--color-bg-main)); color: rgb(var(--color-text-main));">
    <!-- Top Bar -->
    <div class="max-w-3xl mx-auto px-4 md:px-8 pt-8 pb-4">
      <div class="flex items-center justify-between">
        <a href="/" class="report-back">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          <span>Dashboard</span>
        </a>
        <ThemeToggle />
      </div>
    </div>

    <!-- Desktop: TOC in left margin, report centered -->
    <div class="report-outer">
      <!-- Left margin TOC (desktop only, sticky) -->
      {tocHeadings.length > 0 && (
        <aside class="report-toc-margin" id="report-toc-desktop">
          <div class="report-toc-title">📋 Contents</div>
          <ul>
            {tocHeadings.map(h => (
              <li>
                <a href={`#${h.slug}`} class={h.depth === 3 ? 'toc-level-2' : ''}>
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )}

      <!-- Centered report content -->
      <main class="max-w-3xl mx-auto px-4 md:px-8 pb-8 report-main">
        <article class="report-body">
          <slot />
        </article>

        <!-- Footer -->
        <footer class="mt-12 pt-6" style="border-top: 1px solid rgb(var(--color-border-main));">
          <div class="flex items-center justify-between text-sm" style="color: rgb(var(--color-text-main) / 0.6);">
            <a href="/" style="color: rgb(var(--color-text-main)); text-decoration: underline; text-decoration-style: solid; text-underline-offset: 2px;">← Back to all reports</a>
            <span>AI Research</span>
          </div>
        </footer>
      </main>
    </div>

    <style>
      /* Desktop: TOC floats in left margin */
      .report-outer {
        position: relative;
      }

      .report-toc-margin {
        position: fixed;
        top: 6rem;
        left: 1rem;
        width: 13rem;
        max-height: calc(100vh - 8rem);
        overflow-y: auto;
        padding: 1rem 1.25rem;
        font-size: 0.8125rem;
        line-height: 1.6;
      }

      .report-toc-margin ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .report-toc-margin li {
        margin-bottom: 0.3rem;
      }

      .report-toc-margin a {
        color: rgb(var(--color-text-main) / 0.5);
        text-decoration: none;
        transition: color 0.15s ease;
        display: block;
      }

      .report-toc-margin a:hover {
        color: rgb(var(--color-text-main));
      }

      .report-toc-margin .toc-active {
        font-weight: 600;
        color: rgb(var(--color-text-main));
        border-left: 2px solid rgb(var(--color-text-main));
        padding-left: 0.5rem;
      }

      .report-toc-margin .toc-level-2 {
        padding-left: 0.875rem;
        font-size: 0.75rem;
      }

      /* Scrollbar */
      .report-toc-margin::-webkit-scrollbar { width: 3px; }
      .report-toc-margin::-webkit-scrollbar-thumb {
        background: rgb(var(--color-text-main) / 0.15);
        border-radius: 2px;
      }

      /* Mobile: hide margin TOC */
      @media (max-width: 1100px) {
        .report-toc-margin {
          display: none;
        }
      }
    </style>

    <script is:inline>
      // Smooth scroll
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });

      // Highlight active TOC link on scroll (desktop only)
      (function() {
        const tocLinks = document.querySelectorAll('.report-toc-margin a[href^="#"]');
        if (tocLinks.length === 0) return;

        const sections = [];
        tocLinks.forEach(link => {
          const id = link.getAttribute('href').slice(1);
          const el = document.getElementById(id);
          if (el) sections.push({ link, el });
        });

        function updateActive() {
          let active = sections[0];
          for (const s of sections) {
            if (s.el.getBoundingClientRect().top <= 100) {
              active = s;
            }
          }
          tocLinks.forEach(l => l.classList.remove('toc-active'));
          if (active) active.link.classList.add('toc-active');
        }

        window.addEventListener('scroll', updateActive, { passive: true });
        updateActive();
      })();
    </script>
  </body>
</html>