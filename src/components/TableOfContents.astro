---
// TableOfContents.astro — auto-generated TOC from headings in report content
// This component scans the page for h2/h3 elements after render and builds a TOC
---

<nav class="report-toc" id="report-toc">
  <div class="report-toc-title">📋 Table of Contents</div>
  <ul id="toc-list"></ul>
</nav>

<script is:inline>
  (function() {
    const tocList = document.getElementById('toc-list');
    if (!tocList) return;

    const headings = document.querySelectorAll('.report-body h2, .report-body h3');
    if (headings.length === 0) return;

    headings.forEach((heading, i) => {
      // Generate an id if not present
      if (!heading.id) {
        heading.id = heading.textContent
          .toLowerCase()
          .replace(/[^\w]+/g, '-')
          .replace(/^-+|-+$/g, '');
      }

      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = '#' + heading.id;
      a.textContent = heading.textContent;
      a.className = heading.tagName === 'H3' ? 'toc-level-2' : '';

      li.appendChild(a);
      tocList.appendChild(li);
    });

    // Hide TOC if no headings found
    if (headings.length === 0) {
      document.getElementById('report-toc').style.display = 'none';
    }
  })();
</script>