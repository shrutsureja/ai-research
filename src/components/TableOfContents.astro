---
// TableOfContents.astro — sidebar TOC for reports
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings = [] } = Astro.props;
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{tocHeadings.length > 0 && (
  <aside class="report-toc-sidebar" id="report-toc">
    <div class="report-toc-title">📋 Contents</div>
    <ul id="toc-list">
      {tocHeadings.map(h => (
        <li>
          <a href={`#${h.slug}`} class={h.depth === 3 ? 'toc-level-2' : ''}>
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}

<script is:inline>
  // Highlight active TOC link on scroll
  (function() {
    const tocLinks = document.querySelectorAll('.report-toc-sidebar a[href^="#"]');
    if (tocLinks.length === 0) return;

    const sections = [];
    tocLinks.forEach(link => {
      const id = link.getAttribute('href').slice(1);
      const el = document.getElementById(id);
      if (el) sections.push({ link, el });
    });

    function updateActive() {
      let active = sections[0];
      for (const s of sections) {
        if (s.el.getBoundingClientRect().top <= 100) {
          active = s;
        }
      }
      tocLinks.forEach(l => l.classList.remove('toc-active'));
      if (active) active.link.classList.add('toc-active');
    }

    window.addEventListener('scroll', updateActive, { passive: true });
    updateActive();
  })();
</script>