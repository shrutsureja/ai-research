---
// SearchBar.astro — client-side search for dashboard (Dante theme)
---

<div class="relative mb-6">
  <div class="relative">
    <svg
      class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4"
      style="color: rgb(var(--color-text-main) / 0.4);"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <input
      id="search-input"
      type="text"
      placeholder="Search reports..."
      class="w-full pl-10 pr-4 py-2.5 rounded-lg focus:outline-none transition-all text-sm"
      style="border: 1px solid rgb(var(--color-border-main)); background: rgb(var(--color-bg-main)); color: rgb(var(--color-text-main));"
    />
    <button
      id="search-clear"
      class="hidden absolute right-3 top-1/2 -translate-y-1/2"
      style="color: rgb(var(--color-text-main) / 0.4);"
      aria-label="Clear search"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</div>

<script is:inline>
  (function() {
    const input = document.getElementById('search-input');
    const clear = document.getElementById('search-clear');
    const cards = document.querySelectorAll('.report-card');
    const noResults = document.getElementById('no-results');

    function filter() {
      const query = input.value.trim().toLowerCase();
      let visible = 0;

      cards.forEach(card => {
        const title = card.dataset.title || '';
        const tags = card.dataset.tags || '';
        const summary = card.dataset.summary || '';
        const matches = !query || title.includes(query) || tags.includes(query) || summary.includes(query);

        const activeTag = document.querySelector('.tag-chip.active');
        const cardTags = card.dataset.tags || '';
        const tagMatch = !activeTag || cardTags.includes(activeTag.dataset.tag);

        if (matches && tagMatch) {
          card.style.display = '';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visible === 0 ? 'block' : 'none';
      }

      clear.classList.toggle('hidden', !query);
    }

    input.addEventListener('input', filter);

    if (clear) {
      clear.addEventListener('click', () => {
        input.value = '';
        filter();
        input.focus();
      });
    }

    document.addEventListener('tag-filter-changed', filter);
  })();
</script>