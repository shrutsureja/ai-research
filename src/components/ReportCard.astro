---
// ReportCard.astro — card for dashboard report list
interface Props {
  title: string;
  summary: string;
  date: string;
  tags: string[];
  slug: string;
}

const { title, summary, date, tags, slug } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a
  href={`/reports/${slug}`}
  class="report-card block p-5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-[#161b22] hover:border-accent dark:hover:border-accent-light transition-all hover:shadow-md group"
  data-title={title.toLowerCase()}
  data-tags={tags.join(' ').toLowerCase()}
  data-summary={summary.toLowerCase()}
>
  <div class="flex items-start justify-between gap-4 mb-2">
    <h3 class="font-bold text-lg text-slate-900 dark:text-slate-100 group-hover:text-accent dark:group-hover:text-accent-light transition-colors leading-snug">
      {title}
    </h3>
    <time class="text-xs text-slate-400 dark:text-slate-500 whitespace-nowrap mt-1">
      {formattedDate}
    </time>
  </div>
  <p class="text-sm text-slate-600 dark:text-slate-400 line-clamp-2 mb-3">
    {summary}
  </p>
  <div class="flex flex-wrap gap-1.5">
    {tags.map(tag => (
      <span class="report-tag">{tag}</span>
    ))}
  </div>
</a>