---
// ReportCard.astro — card for dashboard report list (Dante theme)
interface Props {
  title: string;
  summary: string;
  date: string;
  tags: string[];
  slug: string;
}

const { title, summary, date, tags, slug } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a
  href={`/reports/${slug}`}
  class="report-card block p-5 rounded-lg transition-all group"
  style="border: 1px solid rgb(var(--color-border-main)); background: rgb(var(--color-bg-main));"
  onmouseover="this.style.background='rgb(var(--color-bg-muted))'"
  onmouseout="this.style.background='rgb(var(--color-bg-main))'"
  data-title={title.toLowerCase()}
  data-tags={tags.join(' ').toLowerCase()}
  data-summary={summary.toLowerCase()}
>
  <div class="flex items-start justify-between gap-4 mb-2">
    <h3 class="font-serif text-lg font-medium leading-snug" style="color: rgb(var(--color-text-main));">
      {title}
    </h3>
    <time class="text-xs whitespace-nowrap mt-1" style="color: rgb(var(--color-text-main) / 0.5);">
      {formattedDate}
    </time>
  </div>
  <p class="text-sm mb-3" style="color: rgb(var(--color-text-main) / 0.7);">
    {summary}
  </p>
  <div class="flex flex-wrap gap-1.5">
    {tags.map(tag => (
      <span class="report-tag">{tag}</span>
    ))}
  </div>
</a>